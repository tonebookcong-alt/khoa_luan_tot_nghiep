VISION_SERVICE_HOST=0.0.0.0
VISION_SERVICE_PORT=8000

# Generation YOLO (9 classes — gen_6 → gen_17). File phải tồn tại tại đường dẫn này.
YOLO_WEIGHTS_PATH=app/models/best_v1.pt
YOLO_CONF_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.5
YOLO_IMG_SIZE=640

# Damage YOLO (3 classes — physical_damage, scratch, screen_defect). Tải file best_damage.pt
# (~40MB) từ Kaggle output rồi đặt vào ai-service-vision/app/models/.
DAMAGE_WEIGHTS_PATH=app/models/best_damage.pt
DAMAGE_CONF_THRESHOLD=0.25
DAMAGE_IMG_SIZE=640

# Optional — chỉ dùng cho scripts/auto_prelabel_gemini.py khi label dataset.
GEMINI_API_KEY=
ROBOFLOW_API_KEY=

LOG_LEVEL=INFO
